{
  "name": "ahbab-charity-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --config web/vite.config.ts && wrangler dev --local --port 8787",
    "deploy": "vite build --config web/vite.config.ts && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "db:migrate:local": "wrangler d1 migrations apply ahbab-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ahbab-db --remote",
    "admin:sql": "node scripts/create-admin.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:mobile": "node tests/mobile.mjs",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite build --config web/vite.config.ts --watch",
    "seed:payments": "node scripts/seed-payments.mjs",
    "seed:delegates": "node scripts/seed-delegates.mjs",
    "seed:expenses": "node scripts/seed-expenses.mjs",
    "test:register": "node tests/register.mjs",
    "test:isolation": "node tests/isolation.mjs",
    "check:scope": "node scripts/check-foundation-scope.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "framer-motion": "^14.14.0",
    "hono": "^4.6.0",
    "html-to-image": "^1.11.11",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.49.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "wrangler": "^4.0.0"
  }
}
