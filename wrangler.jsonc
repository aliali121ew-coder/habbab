{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ahbab-registry",
  "account_id": "b9feb23f6cd181cd9c4b39e6594d92c9",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ahbab-db",
      "database_id": "1d3f35fa-a053-404a-8cfb-a28c2d9799ed",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ahbab-files" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "a11e3f5fb2084e019a55bdb49899dae3" }],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "triggers": { "crons": ["0 1 1 * *"] },
  "vars": { "ENVIRONMENT": "production", "CURRENCY": "د.ع" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
